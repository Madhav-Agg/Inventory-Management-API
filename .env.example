# Example environment variables for the Inventory Management API.
#
# NOTE: Spring Boot does NOT read this file automatically. These are simply the
# environment variable names that src/main/resources/application.properties
# resolves. Set them as real environment variables in your shell, IDE run
# configuration, or CI before starting the application.
#
# Copy this file to ".env" only if your tooling loads .env files; otherwise set
# the variables directly (see README -> Installation and Setup).

# Database host (default: localhost)
DB_HOST=localhost

# Database port (default: 3306)
DB_PORT=3306

# Database/schema name (default: inventory_db)
DB_NAME=inventory_db

# Database user (default: root)
DB_USER=root

# Database password (default: empty string - set your real password here)
DB_PASSWORD=change_me
